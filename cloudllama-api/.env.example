SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Optional overrides. Render automatically supplies the public URL, host, and port.
# SOUNDCLOUD_REDIRECT_URI=https://cloud-llama-api.onrender.com/auth/soundcloud/callback
# CHROMEAMP_SERVER_HOST=0.0.0.0
# CHROMEAMP_SERVER_PORT=10000

# Cloud Llama Radio defaults. A profile /likes URL supplies automatic rotation;
# only the configured DJ profile can interrupt it with a live track.
CLOUD_LLAMA_DJ_PROFILE_URL=https://soundcloud.com/jgilla-1
CLOUD_LLAMA_STATION_FALLBACK_URL=https://soundcloud.com/thesoundoftrees/likes
